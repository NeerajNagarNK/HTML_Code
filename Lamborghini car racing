
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>Lamborghini Hyperdrive Racing Game</title>
<style>
  /* Basic reset */
  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  body {
    background: linear-gradient(to bottom, #0d0d0d, #1a1a1a);
    font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    color: #eee;
    display: flex;
    justify-content: center;
    align-items: center;
    height: 100vh;
    user-select: none;
  }

  #gameContainer {
    position: relative;
    width: 800px;
    height: 600px;
    background: linear-gradient(to bottom, #444, #222);
    border-radius: 15px;
    overflow: hidden;
    box-shadow: 0 0 30px #ff2d00;
  }

  canvas#gameCanvas {
    display: block;
    background: linear-gradient(to bottom, #555 0%, #111 100%);
  }

  /* Lamborghini car style */
  #lamboCar {
    position: absolute;
    width: 120px;
    height: 60px;
    background: #ff2d00;
    clip-path: polygon(
      10% 25%, 90% 25%, 100% 50%, 90% 75%, 10% 75%, 0 50%
    );
    box-shadow: 0 0 15px rgba(255, 45, 0, 0.8);
    transition: transform 0.1s ease-out;
    z-index: 10;
  }

  /* Control Panel */
  #controlPanel {
    position: absolute;
    bottom: 15px;
    left: 15px;
    background: rgba(0, 0, 0, 0.7);
    padding: 12px 20px;
    border-radius: 12px;
    backdrop-filter: blur(6px);
    box-shadow: 0 0 20px #ff2d00;
    width: 250px;
    font-weight: bold;
  }

  #controlPanel div {
    margin-bottom: 10px;
    font-size: 18px;
  }

  progress {
    width: 100%;
    height: 18px;
    border-radius: 8px;
    overflow: hidden;
    appearance: none;
  }

  progress::-webkit-progress-bar {
    background-color: #222;
  }

  progress::-webkit-progress-value {
    background-color: #ff2d00;
  }

  /* Instructions */
  #instructions {
    position: absolute;
    top: 15px;
    left: 15px;
    background: rgba(0,0,0,0.6);
    padding: 10px 15px;
    border-radius: 10px;
    font-size: 14px;
    color: #ff2d00;
    max-width: 300px;
    line-height: 1.4;
  }
</style>
</head>
<body>

<div id="gameContainer">
  <canvas id="gameCanvas" width="800" height="600"></canvas>
  <div id="lamboCar"></div>

  <div id="controlPanel">
    <div>SPEED: <span id="speed">0</span> km/h</div>
    <div>NITRO:</div>
    <progress id="nitroGauge" value="100" max="100"></progress>
  </div>

  <div id="instructions">
    <strong>Controls:</strong><br />
    ↑ Accelerate<br />
    ↓ Brake/Reverse<br />
    ← → Steer Left/Right<br />
    Spacebar: Nitro Boost
  </div>
</div>

<script>
  // Setup canvas and context
  const canvas = document.getElementById('gameCanvas');
  const ctx = canvas.getContext('2d');

  // Car element
  const lamboCar = document.getElementById('lamboCar');

  // Control panel elements
  const speedDisplay = document.getElementById('speed');
  const nitroGauge = document.getElementById('nitroGauge');

  // Game variables
  const roadWidth = 400;
  const roadCenterX = canvas.width / 2;
  let roadOffset = 0;

  // Car state
  const car = {
    x: roadCenterX,
    y: 500,
    speed: 0,
    maxSpeed: 300,
    acceleration: 3,
    deceleration: 5,
    handling: 0.08,
    nitro: 100,
    width: 120,
    height: 60,
    angle: 0,
  };

  // Input state
  const keys = {
    ArrowUp: false,
    ArrowDown: false,
    ArrowLeft: false,
    ArrowRight: false,
    Space: false,
  };

  // Listen for keyboard input
  window.addEventListener('keydown', (e) => {
    if (e.code in keys) {
      keys[e.code] = true;
      e.preventDefault();
    }
  });

  window.addEventListener('keyup', (e) => {
    if (e.code in keys) {
      keys[e.code] = false;
      e.preventDefault();
    }
  });

  // Draw road stripes
  function drawRoad() {
    ctx.fillStyle = '#222';
    ctx.fillRect(0, 0, canvas.width, canvas.height);

    // Draw road edges
    ctx.fillStyle = '#444';
    const leftEdge = roadCenterX - roadWidth / 2;
    const rightEdge = roadCenterX + roadWidth / 2;
    ctx.fillRect(leftEdge - 20, 0, 20, canvas.height);
    ctx.fillRect(rightEdge, 0, 20, canvas.height);

    // Draw center dashed line
    ctx.strokeStyle = '#fff';
    ctx.lineWidth = 6;
    ctx.setLineDash([30, 30]);
    ctx.lineDashOffset = -roadOffset;
    ctx.beginPath();
    ctx.moveTo(roadCenterX, 0);
    ctx.lineTo(roadCenterX, canvas.height);
    ctx.stroke();
    ctx.setLineDash([]);
  }

  // Update car position and physics
  function updateCar() {
    // Acceleration and braking
    if (keys.ArrowUp) {
      car.speed += car.acceleration;
    } else if (keys.ArrowDown) {
      car.speed -= car.deceleration;
    } else {
      // Natural deceleration
      car.speed *= 0.97;
    }

    // Nitro boost
    if (keys.Space && car.nitro > 0) {
      car.speed += 6;
      car.nitro -= 1.5;
      if (car.nitro < 0) car.nitro = 0;
    } else {
      // Recharge nitro slowly when not used
      car.nitro += 0.5;
      if (car.nitro > 100) car.nitro = 100;
    }

    // Clamp speed
    if (car.speed > car.maxSpeed) car.speed = car.maxSpeed;
    if (car.speed < -50) car.speed = -50;

    // Steering (only effective when moving forward)
    if (car.speed > 0) {
      if (keys.ArrowLeft) {
        car.angle -= car.handling;
      }
      if (keys.ArrowRight) {
        car.angle += car.handling;
      }
    } else if (car.speed < 0) {
      // Reverse steering inverted
      if (keys.ArrowLeft) {
        car.angle += car.handling;
      }
      if (keys.ArrowRight) {
        car.angle -= car.handling;
      }
    }

    // Update car position based on speed and angle
    car.x += Math.sin(car.angle) * car.speed * 0.1;
    car.y -= Math.cos(car.angle) * car.speed * 0.1;

    // Keep car within road bounds
    const leftLimit = roadCenterX - roadWidth / 2 + car.width / 2;
    const rightLimit = roadCenterX + roadWidth / 2 - car.width / 2;
    if (car.x < leftLimit) {
      car.x = leftLimit;
      car.speed *= -0.3; // Bounce back effect
      flashCarRed();
    } else if (car.x > rightLimit) {
      car.x = rightLimit;
      car.speed *= -0.3;
      flashCarRed();
    }

    // Keep car vertically within canvas (optional)
    if (car.y < 100) car.y = 100;
    if (car.y > canvas.height - 50) car.y = canvas.height - 50;
  }

  // Flash car red on collision
  let flashTimeout;
  function flashCarRed() {
    lamboCar.style.backgroundColor = '#ff0000';
    clearTimeout(flashTimeout);
    flashTimeout = setTimeout(() => {
      lamboCar.style.backgroundColor = '#ff2d00';
    }, 150);
  }

  // Update the car DOM element position and rotation
  function updateCarDOM() {
    lamboCar.style.left = `${car.x - car.width / 2}px`;
    lamboCar.style.top = `${car.y - car.height / 2}px`;
    lamboCar.style.transform = `rotate(${car.angle}rad)`;
  }

  // Update the control panel info
  function updateDashboard() {
    speedDisplay.textContent = Math.round(car.speed);
    nitroGauge.value = car.nitro;
  }

  // Animate road stripes offset for motion illusion
  function updateRoadOffset() {
    roadOffset += car.speed * 0.05;
    if (roadOffset > 60) roadOffset -= 60;
    if (roadOffset < 0) roadOffset += 60;
  }

  // Main game loop
  function gameLoop() {
    updateRoadOffset();
    drawRoad();
    updateCar();
    updateCarDOM();
    updateDashboard();

    requestAnimationFrame(gameLoop);
  }

  // Start the game loop
  gameLoop();
</script>

</body>
</html>
